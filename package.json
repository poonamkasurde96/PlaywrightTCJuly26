{
  "dependencies": {
    "dotevn": "^0.0.1-security",
    "tsx": "^4.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2"
  },
  "scripts": {
   "fullTest" : "npx playwright test",
   "smokeTest" : "npx playwright test -g @smoke",
   "regressionTest": "npx playwright test -g @regression",
   "allure:clean": "powershell -command \"if (Test-path allure-results) {Remove-item -Force allure-results}\" ",
   "allure:report ": "npx allure serve allure-result ",
   "test:allure":"npm run allure:clean && npm run somkeTest && npm run allure:report "

  }
}
